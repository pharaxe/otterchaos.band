---
layout: base.njk
image: /otterchaos-ograph.png
pagination:
  data: products
  size: 1
  alias: merchItem
permalink: "/merch/{{ merchItem.slug }}/index.html"
eleventyComputed:
  title: "Otter Chaos! Band Merch"
  description: "Buy Otter Chaos! {{ merchItem.name }}"
  url: "otterchaos.band/merch/{{ merchItem.slug }}"
---

<div class="section-wrapper flex w-full flex-1 flex-col">
  <section class="hero-section flex w-full flex-1 flex-col">
    <div class="pt-4 mx-auto flex w-full flex-1 flex-col lg:pt-10">
      <h1 class="mb-4 flex flex-wrap items-baseline gap-2 text-left">
        <a href="/merch" class="rounded px-2 py-1 text-xl font-extrabold leading-none text-[#583e26] transition-colors hover:bg-emerald-500 md:text-3xl xl:text-4xl">
          Band Merch
        </a>
        <span class="text-lg font-bold text-gray-500 md:text-2xl xl:text-3xl">/</span>
        <span aria-current="page" class="rounded px-2 py-1 text-xl font-extrabold leading-none text-[#583e26] md:text-3xl xl:text-4xl">
          {{ merchItem.name }}
        </span>
      </h1>
      {% include "merch-statement.njk" %}

      {% if merchItem.isShirt %}
        <div
          id="tshirt-specs-modal"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4 py-6"
          aria-hidden="true"
        >
          <div class="w-full max-w-lg rounded-2xl bg-stone-100 p-6 shadow-2xl ring-1 ring-black/10">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-2xl font-bold text-[#583e26]">T-Shirt Specs</h2>
              <button
                type="button"
                id="tshirt-specs-close"
                class="rounded-full p-2 text-stone-600 hover:bg-stone-200 hover:text-stone-900"
                aria-label="Close specs modal"
              >
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <ul class="mt-4 list-disc space-y-2 pl-6 text-left text-gray-800 md:text-lg">
              <li>100% Airlume combed and ring-spun cotton</li>
              <li>Pre-shrunk</li>
              <li>Retail fit</li>
              <li>Unisex sizing</li>
              <li>Coverstitched collar and sleeves</li>
              <li>Shoulder-to-shoulder taping</li>
              <li>Side seams</li>
              <li>Tear away label</li>
            </ul>
          </div>
        </div>

        <div
          id="tshirt-size-chart-modal"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 px-4 py-6"
          aria-hidden="true"
        >
          <div class="w-full max-w-4xl rounded-2xl bg-stone-100 p-6 shadow-2xl ring-1 ring-black/10">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-2xl font-bold text-[#583e26]">Size Chart (in inches)</h2>
              <button
                type="button"
                id="tshirt-size-chart-close"
                class="rounded-full p-2 text-stone-600 hover:bg-stone-200 hover:text-stone-900"
                aria-label="Close size chart modal"
              >
                <span aria-hidden="true">&times;</span>
              </button>
            </div>

            <div class="mt-4 overflow-x-auto">
              <table class="min-w-full border-collapse text-left text-sm text-gray-800 md:text-base">
                <thead>
                  <tr class="border-b border-stone-300">
                    <th class="px-3 py-2 font-semibold"></th>
                    <th class="px-3 py-2 font-semibold">XS</th>
                    <th class="px-3 py-2 font-semibold">S</th>
                    <th class="px-3 py-2 font-semibold">M</th>
                    <th class="px-3 py-2 font-semibold">L</th>
                    <th class="px-3 py-2 font-semibold">XL</th>
                    <th class="px-3 py-2 font-semibold">2XL</th>
                    <th class="px-3 py-2 font-semibold">3XL</th>
                    <th class="px-3 py-2 font-semibold">4XL</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-stone-200">
                    <th class="px-3 py-2 font-semibold">Body Length</th>
                    <td class="px-3 py-2">27</td>
                    <td class="px-3 py-2">28</td>
                    <td class="px-3 py-2">29</td>
                    <td class="px-3 py-2">30</td>
                    <td class="px-3 py-2">31</td>
                    <td class="px-3 py-2">32</td>
                    <td class="px-3 py-2">33</td>
                    <td class="px-3 py-2">34</td>
                  </tr>
                  <tr class="border-b border-stone-200">
                    <th class="px-3 py-2 font-semibold">Body Length Tolerance</th>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                  </tr>
                  <tr class="border-b border-stone-200">
                    <th class="px-3 py-2 font-semibold">Chest Tolerance</th>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                    <td class="px-3 py-2">1</td>
                  </tr>
                  <tr class="border-b border-stone-200">
                    <th class="px-3 py-2 font-semibold">Chest Width (Laid Flat)</th>
                    <td class="px-3 py-2">16 1/2</td>
                    <td class="px-3 py-2">18</td>
                    <td class="px-3 py-2">20</td>
                    <td class="px-3 py-2">22</td>
                    <td class="px-3 py-2">24</td>
                    <td class="px-3 py-2">26</td>
                    <td class="px-3 py-2">28</td>
                    <td class="px-3 py-2">30</td>
                  </tr>
                  <tr>
                    <th class="px-3 py-2 font-semibold">Neck Size</th>
                    <td class="px-3 py-2">6</td>
                    <td class="px-3 py-2">6 1/2</td>
                    <td class="px-3 py-2">6 3/4</td>
                    <td class="px-3 py-2">7</td>
                    <td class="px-3 py-2">7 1/2</td>
                    <td class="px-3 py-2">7 3/4</td>
                    <td class="px-3 py-2">7 3/4</td>
                    <td class="px-3 py-2">8</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      {% endif %}

      <div class="ml-2 rounded-2xl border border-stone-300 bg-stone-100 p-4 shadow-sm md:p-6">
        <div class="relative min-h-[440px]">
          <div id="{{ merchItem.shopifyLoaderId }}" class="absolute inset-0 z-10 flex items-center justify-center transition-opacity duration-300">
            <span class="h-12 w-12 animate-spin rounded-full border-4 border-emerald-200 border-t-emerald-600"></span>
          </div>
          <div id='{{ merchItem.shopifyProductNodeId }}' class="min-h-[440px] opacity-0 pointer-events-none transition-opacity duration-300"></div>
        </div>
        {% if merchItem.isShirt %}
          <div class="mt-4 flex flex-wrap gap-3 justify-center">
            <button
            type="button"
            id="tshirt-specs-trigger"
            class="inline-flex items-center rounded-full border border-emerald-600 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50"
          >
            Specs
            </button>
            <button
            type="button"
            id="tshirt-size-chart-trigger"
            class="inline-flex items-center rounded-full border border-emerald-600 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-50"
          >
            Size Chart
          </button>
          </div>
        {% endif %}
      </div>

      {% set shopifyProductId = merchItem.shopifyProductId %}
      {% set shopifyProductNodeId = merchItem.shopifyProductNodeId %}
      {% set shopifyLoaderId = merchItem.shopifyLoaderId %}
      {% include "shopify-product-script.njk" %}

      {% if merchItem.isShirt %}
        <script type="text/javascript">
          (function () {
            function setupModal(triggerId, modalId, closeId) {
              var trigger = document.getElementById(triggerId);
              var modal = document.getElementById(modalId);
              var closeButton = document.getElementById(closeId);

              if (!trigger || !modal || !closeButton) {
                return;
              }

              function openModal() {
                modal
                  .classList
                  .remove('hidden');
                modal
                  .classList
                  .add('flex');
                modal.setAttribute('aria-hidden', 'false');
                closeButton.focus();
              }

              function closeModal() {
                modal
                  .classList
                  .add('hidden');
                modal
                  .classList
                  .remove('flex');
                modal.setAttribute('aria-hidden', 'true');
                trigger.focus();
              }

              trigger.addEventListener('click', openModal);
              closeButton.addEventListener('click', closeModal);

              modal.addEventListener('click', function (event) {
                if (event.target === modal) {
                  closeModal();
                }
              });

              document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
                  closeModal();
                }
              });
            }

            setupModal('tshirt-specs-trigger', 'tshirt-specs-modal', 'tshirt-specs-close');
            setupModal('tshirt-size-chart-trigger', 'tshirt-size-chart-modal', 'tshirt-size-chart-close');
          })();
        </script>
      {% endif %}

      {% include "merch-footer.njk" %}
    </div>
  </section>
</div>