---
title: Otter Chaos! Merch
layout: base.njk
description: Buy Otter Chaos! Band Merch
image: /otterchaos-ograph.png
url: otterchaos.band/merch
---

<div class="section-wrapper flex w-full flex-1 flex-col">
  <section class="hero-section flex w-full flex-1 flex-col">
    <div class="pt-4 mx-auto flex w-full flex-1 flex-col lg:pt-10">
      <h1 class="mb-4 text-left">
        <span class="inline-block rounded px-2 py-1 text-xl font-extrabold leading-none text-[#583e26] md:text-3xl xl:text-4xl">
          Band Merch
        </span>
      </h1>
      {% include "merch-statement.njk" %}

      <div class="ml-2 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {% for item in products %}
          <div class="group flex flex-col text-center">
            <a href="/merch/{{ item.slug }}" class="flex min-h-[320px] items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-white p-3 transition-shadow hover:shadow-lg group-hover:shadow-lg">
              {% image
              item.image,
              item.alt,
              "null" %}
            </a>
            <a href="/merch/{{ item.slug }}" class="mt-4 block text-xl font-bold text-[#583e26] hover:underline group-hover:underline">{{ item.name }}</a>
            <a href="/merch/{{ item.slug }}" class="mt-1 block text-lg font-semibold text-gray-800 hover:underline group-hover:underline">{{ item.price }}</a>
          </div>
        {% endfor %}
      </div>

      {% include "merch-footer.njk" %}
    </div>
  </section>
</div>