<script type="text/javascript">
  /* <![CDATA[ */
  (function () {
    var productId = '{{ shopifyProductId }}';
    var productNodeId = '{{ shopifyProductNodeId }}';
    var loaderNodeId = '{{ shopifyLoaderId }}';
    var iframeAwareReveal ={% if shopifyIframeAwareReveal is defined and not shopifyIframeAwareReveal %}false
    {% else %}
      true{% endif %};
    var scriptURL = 'https://sdks.shopifycdn.com/buy-button/latest/buy-button-storefront.min.js';

    if (window.ShopifyBuy) {
      if (window.ShopifyBuy.UI) {
        ShopifyBuyInit();
      } else {
        loadScript();
      }
    } else {
      loadScript();
    }

    function loadScript() {
      var script = document.createElement('script');
      script.async = true;
      script.src = scriptURL;
      (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(script);
      script.onload = ShopifyBuyInit;
    }

    function revealProduct() {
      var loader = document.getElementById(loaderNodeId);
      var productNode = document.getElementById(productNodeId);

      if (loader) {
        loader
          .classList
          .add('opacity-0', 'pointer-events-none');
      }

      if (productNode) {
        productNode
          .classList
          .remove('opacity-0', 'pointer-events-none');
      }
    }

    function waitForProductReady() {
      var productNode = document.getElementById(productNodeId);
      var attempts = 0;
      var maxAttempts = 80;
      var interval = setInterval(function () {
        attempts += 1;

        if (!productNode) {
          clearInterval(interval);
          revealProduct();
          return;
        }

        var iframe = productNode.querySelector('iframe');
        var hasContent = productNode.children.length > 0;

        if (iframeAwareReveal && iframe) {
          clearInterval(interval);

          var revealed = false;
          function finishReveal() {
            if (revealed) {
              return;
            }
            revealed = true;
            revealProduct();
          }

          iframe.addEventListener('load', finishReveal, {once: true});
          setTimeout(finishReveal, 1200);
          return;
        }

        if (hasContent || attempts >= maxAttempts) {
          clearInterval(interval);
          revealProduct();
        }
      }, 100);
    }

    function ShopifyBuyInit() {
      var client = ShopifyBuy.buildClient({domain: 'otter-chaos-band-merch.myshopify.com', storefrontAccessToken: '2658057bbfc76a76785906bd6d467fd4'});
      ShopifyBuy
        .UI
        .onReady(client)
        .then(function (ui) {
          ui.createComponent('product', {
            id: productId,
            node: document.getElementById(productNodeId),
            moneyFormat: '%24%7B%7Bamount%7D%7D',
            options: {
              "product": {
                "styles": {
                  "product": {
                    "@media (min-width: 601px)": {
                      "max-width": "100%",
                      "margin-left": "0",
                      "margin-bottom": "50px"
                    },
                    "text-align": "left"
                  },
                  "imgWithCarousel": {
                    "max-height": "450px",
                    "object-fit": "contain"
                  },
                  "img": {
                    "max-height": "450px",
                    "object-fit": "contain"
                  },
                  "title": {
                    "font-size": "26px"
                  },
                  "description": {
                    "font-size": "16px"
                  },
                  "button": {
                    "font-family": "Source Sans Pro, sans-serif",
                    "font-weight": "bold",
                    "font-size": "17px",
                    "padding-top": "16.5px",
                    "padding-bottom": "16.5px",
                    ":hover": {
                      "background-color": "#05875f"
                    },
                    "background-color": "#059669",
                    ":focus": {
                      "background-color": "#05875f"
                    }
                  },
                  "quantityInput": {
                    "font-size": "17px",
                    "padding-top": "16.5px",
                    "padding-bottom": "16.5px"
                  },
                  "price": {
                    "font-size": "18px"
                  },
                  "compareAt": {
                    "font-size": "15.299999999999999px"
                  },
                  "unitPrice": {
                    "font-size": "15.299999999999999px"
                  }
                },
                "layout": "horizontal",
                "contents": {
                  "img": false,
                  "imgWithCarousel": true,
                  "description": true
                },
                "width": "100%",
                "text": {
                  "button": "Add to cart"
                },
                "googleFonts": ["Source Sans Pro"]
              },
              "productSet": {
                "styles": {
                  "products": {
                    "@media (min-width: 601px)": {
                      "margin-left": "-20px"
                    }
                  }
                }
              },
              "modalProduct": {
                "contents": {
                  "img": false,
                  "imgWithCarousel": true,
                  "button": false,
                  "buttonWithQuantity": true
                },
                "styles": {
                  "product": {
                    "@media (min-width: 601px)": {
                      "max-width": "100%",
                      "margin-left": "0px",
                      "margin-bottom": "0px"
                    }
                  },
                  "imgWithCarousel": {
                    "max-height": "520px",
                    "object-fit": "contain"
                  },
                  "img": {
                    "max-height": "520px",
                    "object-fit": "contain"
                  },
                  "button": {
                    "font-family": "Source Sans Pro, sans-serif",
                    "font-weight": "bold",
                    "font-size": "17px",
                    "padding-top": "16.5px",
                    "padding-bottom": "16.5px",
                    ":hover": {
                      "background-color": "#05875f"
                    },
                    "background-color": "#059669",
                    ":focus": {
                      "background-color": "#05875f"
                    }
                  },
                  "quantityInput": {
                    "font-size": "17px",
                    "padding-top": "16.5px",
                    "padding-bottom": "16.5px"
                  },
                  "title": {
                    "font-family": "Helvetica Neue, sans-serif",
                    "font-weight": "bold",
                    "font-size": "26px",
                    "color": "#4c4c4c"
                  },
                  "price": {
                    "font-family": "Helvetica Neue, sans-serif",
                    "font-weight": "normal",
                    "font-size": "18px",
                    "color": "#4c4c4c"
                  },
                  "compareAt": {
                    "font-family": "Helvetica Neue, sans-serif",
                    "font-weight": "normal",
                    "font-size": "15.299999999999999px",
                    "color": "#4c4c4c"
                  },
                  "unitPrice": {
                    "font-family": "Helvetica Neue, sans-serif",
                    "font-weight": "normal",
                    "font-size": "15.299999999999999px",
                    "color": "#4c4c4c"
                  }
                },
                "googleFonts": ["Source Sans Pro"],
                "text": {
                  "button": "Add to cart"
                }
              },
              "option": {},
              "cart": {
                "styles": {
                  "button": {
                    "font-family": "Source Sans Pro, sans-serif",
                    "font-weight": "bold",
                    "font-size": "17px",
                    "padding-top": "16.5px",
                    "padding-bottom": "16.5px",
                    ":hover": {
                      "background-color": "#05875f"
                    },
                    "background-color": "#059669",
                    ":focus": {
                      "background-color": "#05875f"
                    }
                  }
                },
                "text": {
                  "total": "Subtotal",
                  "button": "Checkout"
                },
                "googleFonts": ["Source Sans Pro"]
              },
              "toggle": {
                "styles": {
                  "toggle": {
                    "font-family": "Source Sans Pro, sans-serif",
                    "font-weight": "bold",
                    "background-color": "#059669",
                    ":hover": {
                      "background-color": "#05875f"
                    },
                    ":focus": {
                      "background-color": "#05875f"
                    }
                  },
                  "count": {
                    "font-size": "17px"
                  }
                },
                "googleFonts": ["Source Sans Pro"]
              }
            }
          });
          waitForProductReady();
        });
    }
  })();
  /* ]]> */
</script>