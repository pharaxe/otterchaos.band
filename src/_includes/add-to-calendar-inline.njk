{% set links = show | calendarLinks %}
{% if links %}
  {% set menuId = "calendar-links-" + (show.slug or "show") %}
  <span class="calendar-dropdown relative inline-flex items-center align-middle ml-1">
    <button
      type="button"
      class="inline-flex items-center gap-1 text-sm text-emerald-900 underline decoration-dotted underline-offset-2 hover:text-emerald-950 focus:outline-none focus:ring-2 focus:ring-emerald-700 rounded-sm px-1 py-0.5 cursor-pointer"
      aria-label="Add this show to your calendar"
      aria-controls="{{ menuId }}"
      aria-haspopup="menu"
      title="Add to your calendar"
    >
      Add to your calendar
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path fill-rule="evenodd" d="M6 2a1 1 0 012 0v1h4V2a1 1 0 112 0v1h1a3 3 0 013 3v4.5a1 1 0 11-2 0V9H4v6a1 1 0 001 1h5.5a1 1 0 110 2H5a3 3 0 01-3-3V6a3 3 0 013-3h1V2zm-2 5h12V6a1 1 0 00-1-1h-1v1a1 1 0 11-2 0V5H8v1a1 1 0 11-2 0V5H5a1 1 0 00-1 1v1zm11 4a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z" clip-rule="evenodd"></path>
      </svg>
    </button>

    <div id="{{ menuId }}" class="calendar-details-menu absolute left-0 top-full z-30 mt-0 min-w-52 rounded-md border border-stone-300 bg-white p-1 pt-2 shadow-lg" role="menu" aria-label="Calendar links">
      <a class="block rounded px-3 py-2 text-sm text-left text-stone-800 hover:bg-stone-100" href="{{ links.google }}" target="_blank" rel="noopener">Google Calendar</a>
      <a class="block rounded px-3 py-2 text-sm text-left text-stone-800 hover:bg-stone-100" href="{{ links.outlook }}" target="_blank" rel="noopener">Outlook Calendar</a>
      <a class="block rounded px-3 py-2 text-sm text-left text-stone-800 hover:bg-stone-100" href="{{ links.yahoo }}" target="_blank" rel="noopener">Yahoo Calendar</a>
      <a class="block rounded px-3 py-2 text-sm text-left text-stone-800 hover:bg-stone-100" href="{{ links.ics }}" download="otter-chaos-show.ics">Apple Calendar (.ics)</a>
    </div>
  </span>
{% endif %}